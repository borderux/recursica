{
  "$schema": "./src/adapter-tester.schema.json",
  "name": "MUI",
  "storybook": {
    "port": 6012,
    "command": "npm run storybook",
    "cwd": "../mui-adapter"
  },
  "sourceOfTruth": {
    "type": "url",
    "name": "Mantine",
    "port": 6011,
    "command": "npm run storybook",
    "cwd": "../mantine-adapter"
  },
  "diffThresholdPixels": 3500,
  "storyThresholds": {
    "ui-kit-checkboxgroup": 15000,
    "ui-kit-radiogroup": 15000,
    "ui-kit-switchgroup": 15000,
    "ui-kit-checkbox": 15000,
    "ui-kit-radio": 15000,
    "ui-kit-switch": 15000,
    "ui-kit-segmentedcontrol": 15000,
    "ui-kit-numberinput": 15000,
    "ui-kit-slider": 15000,
    "ui-kit-textfield": 15000,
    "ui-kit-timeline": 15000,
    "ui-kit-title": 15000
  }
}
